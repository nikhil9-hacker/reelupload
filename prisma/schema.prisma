datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String         @id @default(uuid())
  email                 String         @unique
  name                  String?
  instagramConnected    Boolean        @default(false)
  instagramUserId       String?
  instagramUsername     String?
  facebookPageId        String?
  facebookPageName      String?
  accessToken           String?
  tokenExpiry           DateTime?
  connectedAt           DateTime?
  googleDriveConnected  Boolean        @default(false)
  googleConnected       Boolean        @default(false)
  googleEmail           String?
  googleUserId          String?
  googleRefreshToken    String?
  googleAccessToken     String?
  googleTokenExpiry     DateTime?
  driveFolderId         String?
  driveFolderName       String?
  driveFolderPath       String?
  driveId               String?
  lastSyncAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  driveFiles            DriveFile[]
  scheduledJobs         ScheduledJob[]
}

model DriveFile {
  id            String         @id @default(uuid())
  userId        String
  driveFileId   String         @unique
  videoName     String
  videoMimeType String?
  videoSize     BigInt?
  captionFileId String?
  captionName   String?
  captionText   String?        @db.Text
  pairHash      String?
  status        DriveFileStatus @default(DETECTED)
  firstSeenAt   DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs          ScheduledJob[]

  @@index([userId])
  @@index([status])
}

model ScheduledJob {
  id               String     @id @default(uuid())
  userId           String
  driveFileId      String
  scheduledAt      DateTime
  timezone         String     @default("UTC")
  caption          String?    @db.Text
  status           JobStatus  @default(PENDING)
  retries          Int        @default(0)
  maxRetries       Int        @default(3)
  errorLog         String?    @db.Text
  publishedAt      DateTime?
  instagramMediaId String?
  containerId      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  driveFile        DriveFile  @relation(fields: [driveFileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
}

enum DriveFileStatus {
  DETECTED
  PAIRED
  UNPAIRED
}

enum JobStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  CANCELLED
  PAUSED
}
